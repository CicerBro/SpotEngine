FROM oven/bun:1 AS assets

WORKDIR /app

COPY package.json bun.lock vite.config.js ./
COPY resources ./resources
COPY public ./public

RUN bun install --frozen-lockfile
RUN bun run build

FROM dunglas/frankenphp:1-php8.5

WORKDIR /app

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

RUN install-php-extensions \
    bcmath \
    pcntl \
    pdo_pgsql \
    pgsql \
    redis \
    sockets

RUN apt update && apt install -y curl ca-certificates
RUN install -d /usr/share/postgresql-common/pgdg
RUN curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc
RUN printf "Types: deb deb-src\nURIs: https://apt.postgresql.org/pub/repos/apt\nSuites: resolute-pgdg\nArchitectures: amd64\nComponents: main\nSigned-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc\n" > /etc/apt/sources.list.d/postgres.sources

RUN apt update && apt install -y postgresql-client-18

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY docker/frankenphp/Caddyfile /etc/frankenphp/Caddyfile
COPY docker/frankenphp/conf.d/99-app.ini /usr/local/etc/php/conf.d/99-app.ini

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

COPY . .
COPY --from=assets /app/public/build /app/public/build

RUN rm -f .env \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data /app/storage /app/bootstrap/cache

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
