APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=spotengine
DB_USERNAME=spotengine
DB_PASSWORD=

SESSION_DRIVER=database
# When using Octane, use database or redis (not file).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Optional when using Octane: set CACHE_STORE=octane for in-memory cache (see README).
CACHE_PREFIX=spotengine-cache-

# Optional: Laravel Octane (only used when running php artisan octane:start or composer run dev:octane)
# OCTANE_SERVER=frankenphp
# OCTANE_HTTPS=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=

# SpotEngine: Usenet/NNTP server for fetching spots (SSL typically on port 563; CONNECTIONS = parallelism)
NNTP_HOST=
NNTP_PORT=119
NNTP_SSL=false
NNTP_USERNAME=
NNTP_PASSWORD=
NNTP_TIMEOUT=60
NNTP_CONNECTIONS=40
NNTP_GROUP_SPOTS=free.pt
NNTP_GROUP_NZB=alt.binaries.ftd

# SpotEngine: search backend (database or manticore)
SEARCH_DRIVER=database

# SpotEngine: cache retention; files older than this are pruned by spot cache prune command
CACHE_NZB_RETENTION_DAYS=30
CACHE_IMAGE_RETENTION_DAYS=30

# SpotEngine: retrieval batch size (articles per XOVER batch)
RETRIEVAL_BATCH_SIZE=5000
# SpotEngine: fetch forward retrieval newest-first (true) or oldest-first (false)
RETRIEVAL_FORWARD_NEW_TO_OLD=true

# SpotEngine: listing cache (avoid redundant queries; flushed on new spot retrieval)
LISTING_CACHE_ENABLED=false
LISTING_CACHE_TTL=30

# SpotEngine: allow new user registration (admin can override in settings)
REGISTRATION_OPEN=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
